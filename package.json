{
  "name": "ui-dojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:agent": "turbo run dev --filter=@repo/agent",
    "dev:api": "turbo run dev --filter=@repo/mock-api",
    "dev:mobile": "pnpm --filter @repo/mobile run start",
    "dev:ios": "pnpm --filter @repo/mobile run ios",
    "dev:android": "pnpm --filter @repo/mobile run android",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@repo/web",
    "build:agent": "turbo run build --filter=@repo/agent",
    "build:ios": "pnpm --filter @repo/mobile run build:ios",
    "build:android": "pnpm --filter @repo/mobile run build:android",
    "preview:web": "pnpm --filter @repo/web run preview",
    "start:agent": "pnpm --filter @repo/agent run start",
    "deploy:agent": "pnpm --filter @repo/agent run deploy",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.7.4",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "packageManager": "pnpm@10.18.2"
}
